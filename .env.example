# Required: the public URL the tag posts to. One DNS A record on a subdomain you control.
SMB_PUBLIC_URL=https://t.example.com

# Timezone for analysis windows and the claim summary (IANA name).
SMB_TZ=Europe/London

# Days to keep click records. Minimum 60 (Google's claim window). Purged nightly.
SMB_RETENTION_DAYS=90

# Upload size cap in MB, uncompressed.
SMB_MAX_UPLOAD_MB=100

# Show a notice in the UI when the data directory exceeds this many MB.
SMB_STORE_WARN_MB=2048

# Anonymous usage counts. See TELEMETRY.md for every field sent. Set to "off" to disable.
SMB_TELEMETRY=on

# Daily check for a newer version (separate from telemetry). Set to "off" to disable.
SMB_UPDATE_CHECK=on

# info | debug. Visitor IPs are never logged at info.
SMB_LOG_LEVEL=info

# Token for AI assistants (MCP) at /mcp. Leave unset to manage it from Settings → AI assistants instead.
# With neither, /mcp answers 404. Use a long random value: openssl rand -base64 32
# SMB_MCP_TOKEN=

# Owner sign-in with Google (docs/owner-sign-in.md). With a client ID set, every UI request needs a sign-in by
# SMB_OWNER_EMAIL; without one, the UI stays loopback-only and unauthenticated. Register the redirect URI
# <SMB_UI_URL or http://localhost:8080>/auth/google/callback on the OAuth client.
# SMB_GOOGLE_CLIENT_ID=
# SMB_GOOGLE_CLIENT_SECRET=
# SMB_OWNER_EMAIL=you@example.com
# The address you open the UI at, when it isn't localhost on this port.
# SMB_UI_URL=https://ui.example.com

# Base64 of exactly 32 random bytes: openssl rand -base64 32. Environment only; keep it out of backups of /data.
# SMB_SECRET_KEY=

# With SMB_TRUST_PROXY=1: addresses allowed to set X-Forwarded-For. "private" (loopback and private ranges) suits
# the Compose file; list addresses or CIDR ranges for a proxy that connects from elsewhere.
# SMB_TRUSTED_PROXIES=private
